  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spegel 参数",
  "type": "object",
  "properties": {
    "spegel": {
      "type": "object",
      "properties": {
        "mirroredRegistries": {
          "type": "array",
          "title": "需要镜像的上游仓库",
